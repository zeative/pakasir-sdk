{
  "name": "pakasir-sdk",
  "description": "Pakasir SDK - Lightweight Pakasir Payment Gateway API v2 Client Library",
  "version": "2.0.0",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "zaadevofc",
  "repository": {
    "url": "git+https://github.com/zeative/pakasir-sdk.git"
  },
  "homepage": "https://pakasir.com/p/get-started",
  "scripts": {
    "test": "bun test __tests__",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --target node20",
    "r:patch": "npm run build && npm version patch && npm publish",
    "r:minor": "npm run build && npm version minor && npm publish",
    "r:major": "npm run build && npm version major && npm publish"
  },
  "keywords": [
    "pakasir",
    "payment-gateway",
    "library",
    "sdk"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^25.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
